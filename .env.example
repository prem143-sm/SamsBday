# Vercel Blob Storage Token
# Get this from: Vercel Dashboard → Storage → Create Blob → Copy token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_*

# Session signing secret (random string, min 32 chars)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-random-session-secret-here

# Birthday credentials for media management authentication (DD-MM-YYYY format)
# These are convenience credentials only — not strong passwords
SAM_BIRTHDAY=replace-with-sam-secret
PREM_BIRTHDAY=replace-with-prem-secret

# Server-side media update policy (Asia/Kolkata): maximum 5 successful changes
# per day and a 5-minute pause after each successful change.
MEDIA_DAILY_UPDATE_LIMIT=5
MEDIA_UPDATE_COOLDOWN_SECONDS=300
