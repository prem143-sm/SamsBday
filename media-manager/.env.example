# Admin account. The user ID is the only login credential.
ADMIN_USERNAME=admin
AUTH_SECRET=

# Fine-grained GitHub token restricted to the media repository.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_BRANCH=main

# Required only for large/production uploads staged through private temporary storage.
BLOB_READ_WRITE_TOKEN=

MEDIA_MAX_BUNDLE_SIZE_MB=100
MEDIA_TIMEZONE=Asia/Kolkata
